{
  "opencollection": "1.0.0",
  "info": {
    "name": "Address Validation 5103 Waiver Veteran Verification API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Veteran Verification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get confirmation about an individual's Veteran status according to the VA",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/address-validation/{version}/status"
          },
          "docs": "Get confirmation about an individual's Veteran status according to the VA"
        },
        {
          "info": {
            "name": "Retrieve disability rating of authorized Veteran",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/address-validation/{version}/disability_rating"
          },
          "docs": "Retrieve disability rating of authorized Veteran"
        },
        {
          "info": {
            "name": "Retrieve service history of authorized Veteran",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/address-validation/{version}/service_history"
          },
          "docs": "Retrieve service history of authorized Veteran"
        }
      ]
    }
  ],
  "bundled": true
}