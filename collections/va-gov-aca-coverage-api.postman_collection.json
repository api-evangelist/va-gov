                      "type": "text/plain"
                    },
                    "key": "apikey",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"person_first_name\": \"Alfredo\",\n  \"person_last_name\": \"Armstrong\",\n  \"person_date_of_birth\": \"1993-06-08\",\n  \"person_ssn_identification\": \"796-01-2476\",\n  \"aca_coverage_start_date\": \"2021-09-01\",\n  \"aca_coverage_end_date\": \"2022-12-31\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": {\n    \"response_code\": \"V0000\",\n    \"description\": \"APPLICANT_ENROLLED\",\n    \"aca_coverage_periods\": [\n      {\n        \"aca_coverage_start_date\": \"2021-09-01\",\n        \"aca_coverage_end_date\": \"2021-09-31\"\n      },\n      {\n        \"aca_coverage_start_date\": \"2022-01-01\",\n        \"aca_coverage_end_date\": \"2022-01-31\"\n      }\n    ]\n  }\n}",
              "cookie": [],
