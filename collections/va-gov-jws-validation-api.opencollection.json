{
  "opencollection": "1.0.0",
  "info": {
    "name": "Address Validation 5103 Waiver JWS Validation API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "JWS Validation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve public keys to check Veteran Verification API token signatures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/address-validation/{version}/keys"
          },
          "docs": "Retrieve public keys to check Veteran Verification API token signatures"
        }
      ]
    }
  ],
  "bundled": true
}